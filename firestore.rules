rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rahmahasti30@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Products catalog: Publicly viewable for webstore browsing & POS
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Orders: Anyone can create order and upload payment proof; admin can manage & approve
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Customers: Manage customer contact details and transaction history
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // POS Transactions: Kasir offline transaksi toko
    match /pos_transactions/{txId} {
      allow read, write: if true;
    }

    // Inventory logs: Mutasi stok barang masuk, keluar, dan opname
    match /inventory_logs/{logId} {
      allow read, write: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Default deny for unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
